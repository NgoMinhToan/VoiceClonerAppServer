# VoiceClonerAppServer - Environment Variables
# Chỉ chứa cài đặt kết nối dịch vụ cơ sở dữ liệu (PostgreSQL) và bộ nhớ đệm (Redis).
# Mọi cài đặt cổng (port), bảo mật (API keys), workers và quota đều nằm trong config/settings.json.

# PostgreSQL Connection Credentials
POSTGRES_USER=voice_user
POSTGRES_PASSWORD=voice_pass
POSTGRES_DB=voicecloner
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://voice_user:voice_pass@db:5432/voicecloner

# Redis Connection URL
REDIS_URL=redis://redis:6379/0

# Optional Docker Image Tag for docker-compose
TAG=latest
