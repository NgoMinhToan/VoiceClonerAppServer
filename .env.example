# VoiceClonerAppServer - Environment Variables
# Chứa cài đặt kết nối dịch vụ cơ sở dữ liệu (PostgreSQL) và bộ nhớ đệm (Redis).
# Hầu hết cài đặt cổng (port), bảo mật (security), workers và quota nằm trong
# config/settings.json. Riêng MANAGEMENT_KEY có thể đặt ở đây và sẽ ghi đè giá
# trị management_key trong config/settings.json.

# PostgreSQL Connection Credentials
POSTGRES_USER=voice_user
POSTGRES_PASSWORD=voice_pass
POSTGRES_DB=voicecloner
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://voice_user:voice_pass@db:5432/voicecloner

# Redis Connection URL
REDIS_URL=redis://redis:6379/0

# Management key required to unlock the dashboard and management API.
# Overrides config/settings.json. Generate one with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to fail closed (dashboard and management API return 503).
MANAGEMENT_KEY=

# Set true when the dashboard is served over HTTPS so the session cookie is
# marked Secure. Keep false for local HTTP development.
DASHBOARD_COOKIE_SECURE=false

# Optional Docker Image Tag for docker-compose
TAG=latest
